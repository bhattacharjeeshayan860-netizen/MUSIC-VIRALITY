# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Optional throttling / retry settings
YOUTUBE_SEARCH_MIN_INTERVAL_SECONDS=7
YOUTUBE_VIDEOS_MIN_INTERVAL_SECONDS=1
YOUTUBE_CHANNELS_MIN_INTERVAL_SECONDS=1
YOUTUBE_MAX_RETRIES=6
YOUTUBE_BACKOFF_BASE_SECONDS=2
YOUTUBE_BACKOFF_MAX_SECONDS=60
